{
  "name": "@gbam/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,http,worker -c gray,cyan,magenta \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"pnpm:dev:http\" \"pnpm:dev:worker\"",
    "dev:http": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "dev:worker": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/worker.js",
    "start:http": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --enable-source-maps --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@gbam/db": "workspace:*",
    "@gbam/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@gbam/config": "workspace:*",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
