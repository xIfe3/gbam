# Copy to .env and fill in. Every var used by a task must also be listed in turbo.json
# (globalEnv or the task's env) or Turbo will serve stale cached builds.

NODE_ENV=development

# Local services from docker/docker-compose.dev.yml
DATABASE_URL=postgres://gbam:gbam@localhost:5433/gbam
REDIS_URL=redis://localhost:6379

# API
PORT=4000

# Web (server-side only)
API_URL=http://localhost:4000
# Shared secret between web and api: a long random string, the SAME value for both.
# The API trusts the visitor IP that apps/web forwards (x-client-ip) only with it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Optional in dev (IP limits then use the socket address); required in production, and
# there it must be at least 32 characters.
INTERNAL_API_SECRET=
# How many reverse proxies sit in front of the web app (default 1). The visitor IP is read
# from X-Real-IP, else this many entries from the RIGHT of X-Forwarded-For (the left-hand
# entries can be faked by the visitor). In production the web app MUST sit behind exactly
# one HTTPS reverse proxy that appends X-Forwarded-For, and its port must not be public.
# TRUSTED_PROXY_HOPS=1
# Seller login: `pnpm db:seed` prints the demo login (demo@gbam.app + a new random password).

# Public URL of the web app (Paystack redirects customers back here)
WEB_URL=http://localhost:3000

# Integrations: leave empty in dev to use fakes that log instead. Required in production.
PAYSTACK_SECRET_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
# WhatsApp webhook (Meta → us). App secret: Meta app → App settings → Basic.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Email (Resend). Leave empty in dev: emails are logged instead of sent. Required in production.
RESEND_API_KEY=
# Optional; the domain must be verified in Resend.
# EMAIL_FROM="Gbam <no-reply@gbam.app>"

# Optional: Gbam WhatsApp number for the contact page, digits only in international format
# (e.g. 2348012345678). The WhatsApp link is hidden when this is unset.
GBAM_WHATSAPP_NUMBER=
