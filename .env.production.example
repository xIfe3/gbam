# For docker/docker-compose.prod.yml. Copy to .env.production (gitignored) and fill in.
POSTGRES_PASSWORD=change-me
WEB_URL=https://gbam.app

# Required when NODE_ENV=production: the API refuses to start without them.
PAYSTACK_SECRET_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp webhook (Meta → us). App secret: Meta app → App settings → Basic.
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook form.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
RESEND_API_KEY=
EMAIL_FROM=Gbam <no-reply@gbam.app>
# Shared secret between web and api: a random string of AT LEAST 32 characters, the SAME
# value for both. The API trusts the visitor IP that apps/web forwards (x-client-ip) only
# with it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_SECRET=
# Product photos in Cloudflare R2 (see docs/integrations-setup.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PHOTOS_PUBLIC_URL=https://photos.gbam.app

# Web: the site MUST sit behind exactly one HTTPS reverse proxy (gbam.app requires HTTPS)
# that appends the visitor's address to X-Forwarded-For. Don't publish the web port
# publicly except through that proxy, or visitors could fake their IP and dodge rate limits.
# Number of trusted proxies in front of the web app; 1 for that single proxy.
TRUSTED_PROXY_HOPS=1

# Optional: Gbam WhatsApp number for the contact page, digits only in international format
# (e.g. 2348012345678). The WhatsApp link is hidden when this is unset.
GBAM_WHATSAPP_NUMBER=

# Error alerts (Sentry). Leave empty in dev: nothing is sent. See docs/integrations-setup.md.
# SENTRY_DSN is used by the API, the worker and the web server; NEXT_PUBLIC_SENTRY_DSN by
# visitors' browsers (same value). The NEXT_PUBLIC_ one is baked in when the site is built.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Admin System page (all optional; each unset panel just says "not set up").
# Sentry: an auth token with read access to issues, plus the org and project slugs.
# SENTRY_API_URL only for EU-hosted Sentry projects (https://de.sentry.io).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_API_URL=
# UptimeRobot read-only API key, for the uptime panel.
UPTIME_API_KEY=

# Admin area: encrypts admins' authenticator secrets. 32 random bytes, base64:
#   openssl rand -base64 32
# Unset → admin sign-in is off. Keep it secret and never change it once admins exist
# (their authenticator apps would stop working).
ADMIN_TOTP_KEY=
