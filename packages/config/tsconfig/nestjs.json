{
  "$schema": "https://json.schemastore.org/tsconfig",
  "description": "NestJS 12 is ESM-only: native ESM output with legacy decorators + metadata. Relative imports need .js extensions.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true
  }
}
